library(tidyverse)
library(janitor)
read_csv(https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv)
read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv")
read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv")
md_cities_rates <- mutate(md_cities,  violent_rate_2019 = violent2019/pop2019 * 1000, property_rate_2019 = property2019/pop2019 * 1000, violent_rate_2020 = violent2020/pop2020 * 1000, property_rate_2020 = property2020/pop2020 * 1000)
md_cities <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv")
md_cities_rates <- mutate(md_cities,  violent_rate_2019 = violent2019/pop2019 * 1000, property_rate_2019 = property2019/pop2019 * 1000, violent_rate_2020 = violent2020/pop2020 * 1000, property_rate_2020 = property2020/pop2020 * 1000)
md_cities_change <- mutate(md_cities_rates, violent_change = (violent_rate_2020 - violent_rate_2019)/violent_rate_2019 * 100, property_change = (property_rate_2020 - property_rate_2019)/property_rate_2019 * 100)
View(md_cities_change)
md_cities_percentiles <- mutate(md_cities_change, percentile = ntile(violent_rate_2020, 100))
View(md_cities_percentiles)
md_cities_percentiles <- mutate(md_cities_change, percentile = ntile(violent_rate_2020, 100))
md_cities_percentiles$property2019 <- NULL
md_cities_percentiles <- mutate(md_cities_change, percentile = ntile(violent_rate_2020, 100))
md_cities_percentiles$property2019 <- NULL
md_cities_percentiles <- mutate(md_cities_change, percentile = ntile(violent_rate_2020, 100))
md_cities_percentiles <- subset(md_cities_percentiles, select = -5)
summarise(IQR = IQR(md_cities_percentiles$violent_rate_2020))
IQR = IQR(md_cities_percentiles$violent_rate_2020)
IQR = IQR(md_cities_percentiles$violent_rate_2020)
IQR
library(tidyverse)
library(tidyverse)
read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/spotify_2020.csv")
spotify_songs <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/spotify_2020.csv")
View(spotify_songs)
summarise(spotify_songs, mean = mean(count), sd = sd(count))
spotify_songs |> summarise(danceability, mean = mean(count), sd = sd(count))
spotify_songs |> summarise(mean_danceability = mean(danceability), sd_danceability = sd(danceability))
car_thefts <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/car_thefts_jan24.csv")
View(car_thefts)
spotify_songs |>
ggplot(danceability) +
geom_histogram(aes(x = count), binwidth = 2)
spotify_songs |>
ggplot() +
geom_histogram(aes(x = count), binwidth = 2)
spotify_songs |>
ggplot() +
geom_histogram(aes(danceability = count), binwidth = 2)
ggplot(spotify_songs, aes(danceability = count)) +
geom_histogram
ggplot(spotify_songs, aes(danceability = count)) +
geom_histogram()
ggplot(spotify_songs, aes(danceability)) +
geom_histogram()
ggplot(spotify_songs, aes(danceability)) +
geom_histogram() +
geom_vline(aes(xintercept = mean(danceability)), color = "red", linetype = "dashed", size = 1)
ggplot(spotify_songs, aes(danceability)) +
geom_histogram() +
geom_vline(aes(xintercept = mean(danceability)), color = "red", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(danceability) + sd(danceability)), color = "blue", linetype = "dashed", size = 1)
ggplot(spotify_songs, aes(danceability)) +
geom_histogram() +
geom_vline(aes(xintercept = mean(danceability)), color = "red", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(danceability) + sd(danceability)), color = "blue", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(danceability) - sd(danceability)), color = "blue", linetype = "dashed", size = 1)
